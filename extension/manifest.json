{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "short_name": "AutoAdmit",
    "description": "__MSG_description__",
    "version": "2026.11.11",
    "default_locale": "en",
    "action": {
        "default_title": "__MSG_actionTitle__",
        "default_icon": "icon.png"
    },
    "permissions": [
        "activeTab"
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://meet.google.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
